{
  "name": "dahangis-main",
  "version": "1.1.0",
  "private": true,
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/check-env.mjs && node scripts/optimize-images.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/verify-export.mjs",
    "start": "node scripts/serve-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "lint": "eslint src tests playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "check": "npm run lint && npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "sharp": "^0.34.3",
    "typescript": "5.9.3"
  }
}
